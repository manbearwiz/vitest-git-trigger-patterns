{
  "name": "vitest-git-trigger-patterns",
  "version": "0.0.0-development",
  "description": "Git VCS provider for Vitest to map broad changed files to focused tests during `--changed` runs",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vitest",
    "git",
    "changed",
    "testing"
  ],
  "scripts": {
    "build": "npm run build:vite && npm run build:types",
    "build:vite": "vite build",
    "build:types": "tsgo -p tsconfig.types.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublint": "npm run build",
    "publint": "publint",
    "semantic-release": "semantic-release",
    "lint": "npx @biomejs/biome check",
    "lint:fix": "npx @biomejs/biome check --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manbearwiz/vitest-git-trigger-patterns.git"
  },
  "author": "Kevin Brey",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/manbearwiz/vitest-git-trigger-patterns/issues"
  },
  "homepage": "https://github.com/manbearwiz/vitest-git-trigger-patterns#readme",
  "peerDependencies": {
    "vitest": "^4.1.1 || ^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-angular": "^21.2.0",
    "@tsconfig/node20": "^20.1.9",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.10",
    "publint": "^0.3.22",
    "semantic-release": "^25.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false
}
